# Salary OS — environment template. Copy to .env and fill in. Never commit .env.
# Keys and their meaning: CLAUDE.md §10.

# ── salary-service ───────────────────────────────────────────────────────────
# Neon POOLED connection string (the one with "-pooler" in the host). sslmode is required.
DATABASE_URL=jdbc:postgresql://ep-xxxx-pooler.REGION.aws.neon.tech/salaryos?sslmode=require
DATABASE_USERNAME=salaryos_app
DATABASE_PASSWORD=replace-me
DATABASE_SCHEMA=salary_schema

# HS256 signing key, >= 32 bytes. Generate: openssl rand -base64 48
APP_JWT_SIGNING_KEY=replace-me-with-at-least-32-bytes-of-random

APP_SESSION_TTL=20m
APP_REFRESH_TTL=12h
APP_COOKIE_DOMAIN=localhost
APP_COOKIE_SAMESITE=Lax
APP_CORS_ORIGINS=http://localhost:3000

# Reproducibility of the 10k-employee seed depends on this. Changing it changes every figure.
APP_SEED_RANDOM_SEED=20260820
APP_BASE_CURRENCY=USD

# ── salary-web ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
