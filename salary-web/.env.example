# Copy to .env.local (git-ignored) for local development.

# The salary-service origin. Used both server-side (getCurrentUser, current-user.ts)
# and client-side (the fetch wrapper, src/lib/api/client.ts) — must be reachable
# from the browser, not just from the Next.js server process.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
