# Copy to application-local.yml (git-ignored) and fill in the Neon credentials, then run with
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# Settings below follow docs/salary-management-backend.md §2.1. The Hikari values are not
# arbitrary: Neon recycles connections, and a max-lifetime longer than this produces intermittent
# failures that only ever reproduce in production.

spring:
  datasource:
    # The POOLED endpoint — the host containing "-pooler". sslmode=require is not optional.
    url: jdbc:postgresql://ep-xxxx-pooler.REGION.aws.neon.tech/salaryos?sslmode=require
    username: salaryos_app
    password: replace-me
    hikari:
      maximum-pool-size: 10
      # Milliseconds, not Spring Duration shorthand — HikariConfig's setters take a raw `long`,
      # and Spring's Binder only accepts "10s"-style strings for a java.time.Duration target.
      # "10s"/"5m" here fails at startup with a NumberFormatException, not silently.
      connection-timeout: 10000  # 10s
      max-lifetime: 300000       # 5m

  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate      # Flyway owns the schema. Never let Hibernate write DDL.
    properties:
      hibernate:
        default_schema: salary_schema

  flyway:
    enabled: true
    schemas: salary_schema
    default-schema: salary_schema
    locations: classpath:db/migration
    # Migrations must NOT run as salaryos_app: Postgres owners always retain full DML on tables
    # they create, so a REVOKE against the owner is a no-op — see V8's audit_events comment. Run
    # Flyway as Neon's project-default owner role instead (the one you land on when the project is
    # created), and let it GRANT salaryos_app only what V8 grants it.
    user: replace-with-neon-owner-role
    password: replace-me-too
